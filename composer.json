{
    "name": "fadhila36/grpcavel",
    "description": "A Laravel-native gRPC framework with code-first protobuf generation and RoadRunner runtime.",
    "authors": [
        {
            "name": "Muhammad Fadhila Abiyyu Faris",
            "homepage": "https://github.com/Fadhila36"
        }
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "google/protobuf": "^4.33",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "spiral/roadrunner-grpc": "^3.5"
    },
    "require-dev": {
        "pestphp/pest": "^2.0 || ^3.0",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^1.12",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Grpcavel\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Grpcavel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Grpcavel\\GrpcavelServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
